# Backend environment variables.
# Copy this file to `.env` and fill in the values before running the backend.

# HTTP port the Express server listens on
PORT=5000
NODE_ENV=development

# MySQL connection.
# Inside Docker Compose the host is the `db` service.
# Running the backend directly on your machine, use `localhost` and port 3307
# (the port docker-compose.yml maps the MySQL container to).
DB_HOST=db
DB_NAME=fincan
DB_USER=root
DB_PASSWORD=change-me

# Secrets used to sign JWTs and session cookies.
# Generate your own, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me
SESSION_SECRET=change-me
